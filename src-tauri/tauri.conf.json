{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memory Card",
  "version": "2.0.0",
  "identifier": "com.sluic.memory-card",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Memory Card",
        "width": 950,
        "height": 900,
        "resizable": false,
        "visible": false,
        "backgroundColor": "#e8ecf4"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*",
          "$HOME/**/*",
          "$APPDATA/**/*"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Sluicee/memory-card/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGRUZCNUI4MzYyNTU4MkUKUldRdVdDVTJ1TFh2TDIwZkNpYWVlUVZZWjVudFl6cDhFdHI3WlFCU2RvVkVwbzV6emxoWk9oV0wK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
